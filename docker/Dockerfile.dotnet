# Kompilator RSL-bis → Flutter (.NET)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/FlutterCodeGenerator/ ./FlutterCodeGenerator/

# Solucja odwołuje się też do ../tests, których nie ma w obrazie – budujemy sam projekt.
RUN dotnet publish FlutterCodeGenerator/FlutterCodeGenerator.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=build /app .

# Argumenty: <folder_z_plikami_.txt> <folder_wyjściowy>
# W compose: command: ["/input", "/output"]
ENTRYPOINT ["dotnet", "FlutterCodeGenerator.dll"]
